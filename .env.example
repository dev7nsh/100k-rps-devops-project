# ─────────────────────────────────────────────────────────────
#  Application
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info          # trace | debug | info | warn | error | fatal

# ─────────────────────────────────────────────────────────────
#  PostgreSQL connection
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=benchmark
DB_USER=benchmark
DB_PASSWORD=benchmark_secret

# ─────────────────────────────────────────────────────────────
#  Connection pool tuning
#  Rule of thumb: (num_cpu_cores * 2) + effective_spindle_count
#  For a 4-core machine: 10–20 per worker; total = workers * pool
# ─────────────────────────────────────────────────────────────
DB_POOL_SIZE=20
DB_POOL_IDLE_TIMEOUT=30000   # ms — release idle connections
DB_POOL_CONNECTION_TIMEOUT=5000  # ms — fail fast if pool exhausted

# ─────────────────────────────────────────────────────────────
#  Benchmark defaults (used by scripts/benchmark.js)
# ─────────────────────────────────────────────────────────────
BENCH_URL=http://localhost:3000
BENCH_DURATION=30            # seconds per run
BENCH_PIPELINING=1           # HTTP pipelining factor (1 = off)
